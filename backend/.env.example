# Server configuration
PORT=5000

# MongoDB Atlas connection string
# Replace <db_username>, <db_password>, and <dbname> with your actual Atlas credentials.
# Format: mongodb+srv://<db_username>:<db_password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mchlilj.mongodb.net/connect_sphere?appName=Cluster0

# JWT secret (use a strong, random string in production)
JWT_SECRET=your_strong_jwt_secret_here

# Frontend / client URL
CLIENT_URL=http://localhost:5173

# Optional initial administrator account; set these before running npm run create-admin
ADMIN_NAME=
ADMIN_HANDLE=
ADMIN_EMAIL=
ADMIN_EMPLOYEE_ID=
ADMIN_PASSWORD=
ADMIN_DEPARTMENT=